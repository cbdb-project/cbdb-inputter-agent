# Secrets / local config
.env
.env.*
!.env.sample
*.env
*.bak

# Local audit logs and processed data (contain real submitted data + tokens' effects)
logs/*
!logs/.gitkeep
data/inbox/*
!data/inbox/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/staging/*
!data/staging/.gitkeep
# Generated build output, one directory per case
# (src/cbdb_agent/places_and_offices).
data/build/*
!data/build/.gitkeep

# The weekly CBDB SQLite snapshot (~557 MB) and the label cache derived from it.
# Downloaded on demand by snapshot.py; see AGENTS.md. Kept inside the repo rather
# than in a user-cache directory so it is visible and deletable, but never committed.
data/cbdb-sqlite/
data/cache/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code local runtime state
.claude/

# The user's own scratch file: raw pasted source material and task notes for
# whatever is in flight. Unpublished person data, and nothing the repo needs.
/notes.md
